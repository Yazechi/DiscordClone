<Window x:Class="DiscordClone.DesktopClient.CreateServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Server" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#313338" ResizeMode="NoResize">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Customize your server" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="SERVER NAME" Foreground="#B5BAC1" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="ServerNameTextBox" Height="40" Background="#1E1F22" Foreground="White" BorderThickness="0" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <Border Height="40" Background="#5865F2" CornerRadius="4">
                <Button Content="Create" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="OnCreateClick"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>