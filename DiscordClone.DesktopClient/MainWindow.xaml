<Window x:Class="DiscordClone.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Clone" Height="720" Width="1280"
        Background="#313338">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <!-- Guild Navigation Bar -->
            <ColumnDefinition Width="240"/>
            <!-- Channels List -->
            <ColumnDefinition Width="*"/>
            <!-- Main Chat Area -->
        </Grid.ColumnDefinitions>

        <!-- Guild List Column -->
        <Border Grid.Column="0" Background="#1E1F22">
            <StackPanel Margin="0,12,0,0">
                <!-- Rounded Container with Button Inside -->
                <Border Height="48" Width="48" Margin="0,0,0,8" Background="#5865F2" CornerRadius="24">
                    <Button Content="Discord" 
                            Foreground="White" 
                            Background="Transparent" 
                            BorderThickness="0"
                            FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Channels Column -->
        <Border Grid.Column="1" Background="#2B2D31">
            <StackPanel Margin="16">
                <TextBlock Text="Server Channels" Foreground="#949BA4" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Clickable General Channel -->
                <Border x:Name="GeneralChannelBorder" 
                        Background="#3f4248" 
                        CornerRadius="4" 
                        Padding="8,6" 
                        Margin="0,2" 
                        Cursor="Hand" 
                        MouseDown="OnChannelClick">
                    <TextBlock Text="# general" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>
        <!-- Main Chat Area -->
        <Grid Grid.Column="2" Background="#313338">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- Channel Header -->
                <RowDefinition Height="*"/>
                <!-- Messages Stream -->
                <RowDefinition Height="68"/>
                <!-- Input Box -->
            </Grid.RowDefinitions>

            <!-- Channel Header -->
            <Border Grid.Row="0" Background="#313338" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                <TextBlock Text="# general" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="16,0"/>
            </Border>

            <!-- Messages Stream -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="14" Margin="0,4" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Message Input Area -->
            <Border Grid.Row="2" Background="#383A40" CornerRadius="8" Margin="16,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox" 
                             Grid.Column="0"
                             Background="Transparent" 
                             Foreground="White" 
                             BorderThickness="0" 
                             Padding="12,0" 
                             FontSize="14" 
                             VerticalContentAlignment="Center"
                             KeyDown="OnMessageTextBoxKeyDown"/>

                    <Border Grid.Column="1" Background="#5865F2" CornerRadius="4" Margin="8">
                        <Button Content="Send" 
                                Foreground="White" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontWeight="Bold"
                                Click="OnSendMessageClick"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>